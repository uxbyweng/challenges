// Erweiterte tsconfig-Datei
// Dies ist die vollständige Konfiguration, die ab sofort verwendet wird.
// Sie baut auf der Minimalkonfiguration auf und fügt Optionen für Umgebungen,
// Module und Codierungsregeln hinzu:

{
    "compilerOptions": {
        "rootDir": "./src", // Quellcode (.ts) liegt hier
        "outDir": "./dist", // kompiliertes JavaScript landet hier
        "target": "esnext", // modernes JavaScript erzeugen, nichts herunterkompilieren
        "lib": ["esnext"], // verfügbare Sprach-Features/Typen (kein DOM, da Node)
        "types": ["node"], // lädt @types/node (console, process, ...)
        "module": "nodenext", // Modulsystem passend zu Node (ESM bei "type": "module")
        "verbatimModuleSyntax": true, // import type und import strikt trennen
        "esModuleInterop": true, // CommonJS-Pakete sauber importieren können
        "resolveJsonModule": true, // import data from 'users.json'
        "sourceMap": true, // .js.map erzeugen, Fehler zeigen auf die .ts-Zeile
        "skipLibCheck": true, // überspringt check von den ganz Libs

        // coding rules
        "strict": true, // alle strengen Typprüfungen an (u. a. strictNullChecks, noImplicitAny)
        "noUnusedLocals": true, // Fehler bei ungenutzten Variablen
        "noUnusedParameters": true, // Fehler bei ungenutzten Funktionsparametern
        "noFallthroughCasesInSwitch": true, // Fehler bei case ohne break/return
        "forceConsistentCasingInFileNames": true // Import-Pfade müssen exakt in Groß-/Kleinschreibung stimmen
    },
    "include": ["src/**/*"], // alles in src/ wird kompiliert
    "exclude": ["node_modules"] // Pakete nie mitkompilieren
}
