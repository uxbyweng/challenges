{
    "name": "backend",
    "module": "src/index.ts",
    "type": "module",
    "private": true,
    "scripts": {
        "dev": "bun --watch --check src/index.ts",
        "start": "bun --check src/index.ts",
        "typecheck": "bun check",
        "build": "bun --bun tsc && cp -R src/public dist/",
        "serve": "bun run build && bun dist/index.js"
    },
    "devDependencies": {
        "@types/bun": "latest",
        "@types/express": "^5.0.6"
    },
    "peerDependencies": {
        "typescript": "^7"
    },
    "dependencies": {
        "express": "^5.3.0"
    }
}
